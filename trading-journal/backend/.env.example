# Configuración del servidor
NODE_ENV=development
PORT=3088

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_journal
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Configuración de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
ALLOWED_ORIGINS=http://localhost:5179

# JWT Authentication
JWT_SECRET=tu-secreto-jwt-muy-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Super administrador (se crea/actualiza al arrancar el servidor)
SUPER_ADMIN_EMAIL=tu-email@gmail.com

# Frontend URL (para CORS y redirecciones)
FRONTEND_URL=http://localhost:5179

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
# Notificaciones push (Web Push). Opcionales: sin ellas el push queda desactivado.
# Generar UNA vez con `npx web-push generate-vapid-keys` y no rotarlas
# (cambiarlas deja inservibles las suscripciones de todos los dispositivos).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto: o https). Default: mailto: + SUPER_ADMIN_EMAIL
VAPID_SUBJECT=
